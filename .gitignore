# =============================================================================
# HACKATHON SUBMISSION — .gitignore
# =============================================================================
# IMPORTANT: Never commit secrets, credentials, or large binary files.

# ── Secrets & Environment ─────────────────────────────────────────────────────
.env
.env.local
.env.production
*.key
*.pem
*.p12
secrets/

models/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/

*.pyo
.Python
venv/
.venv/
env/
pip-log.txt
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
htmlcov/


# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn
dist/
.next/
.nuxt/
.output/
.cache/

# ── Java / Maven / Gradle ────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
.gradle/
build/

# ── Go ────────────────────────────────────────────────────────────────────────
vendor/
*.exe

# ── Rust ──────────────────────────────────────────────────────────────────────
target/
Cargo.lock  # remove this line if you want to commit lock file (recommended for apps)

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Large Media Files (use demo-video-link.txt instead) ───────────────────────
demo/*.mp4
demo/*.mov
demo/*.avi
demo/*.mkv

# ── Docker volumes / local data ───────────────────────────────────────────────
logs/
*.log

# ── Project datasets & generated artifacts ────────────────────────────────────
# Raw NASA C-MAPSS dataset files (large text; readme.txt stays tracked)
src/data/ingestion/nasa/train_FD001.txt
src/data/ingestion/nasa/test_FD001.txt
src/data/ingestion/nasa/RUL_FD001.txt
# Generated FD001 preprocessed CSVs (recreated from raw + scripts)
src/data/preprocessing/*.csv
# Trained model binaries & generated health/anomaly score CSVs (recreated by training scripts)
src/models/health/*.joblib
src/models/health/*.csv

# Trained failure model binary & integration test cache (Member 2 -- recreated by train.py)
src/models/failure/*.joblib
src/models/failure/__pycache__/
=======


# ── Jupyter Notebooks (optional: remove if you want to commit notebooks) ──────
# .ipynb_checkpoints/

# ── Terraform ─────────────────────────────────────────────────────────────────
.terraform/

*.tfstate
*.tfstate.backup
=======
*.tfstate.backup

# ── Frontend (Vite/React) ─────────────────────────────────────────────────────
src/frontend/dist
src/frontend/dist-ssr
src/frontend/*.local
src/frontend/logs
src/frontend/*.log
src/frontend/npm-debug.log*
src/frontend/yarn-debug.log*
src/frontend/yarn-error.log*
src/frontend/pnpm-debug.log*
src/frontend/lerna-debug.log*
src/frontend/node_modules

